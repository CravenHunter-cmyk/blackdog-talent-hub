OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o-mini
NEXT_PUBLIC_BLACKDOG_BRAIN_STORY_VIDEO_URL=https://your-cdn-domain/videos/blackdog-brain-story-v1.mp4

# Video assets are not committed to Git. Upload story videos to object storage/CDN
# and point NEXT_PUBLIC_BLACKDOG_BRAIN_STORY_VIDEO_URL at the deployed file.
# Use a new filename for replacements, for example:
# blackdog-brain-story-v1.mp4
# blackdog-brain-story-v2.mp4
# blackdog-brain-story-v3.mp4
# Do not overwrite the same URL, so CDN and browser caches do not keep stale video.
